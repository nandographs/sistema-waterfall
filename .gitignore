# Variáveis de ambiente: bloqueia TODO .env, com exceção do exemplo sem valores.
# O padrão amplo evita que um .env.production ou .env.staging escape por engano.
.env
.env.*
!.env.example

# Supabase CLI: `link` grava o id do projeto e credenciais temporárias aqui.
# O resto da pasta supabase/ (config.toml e as functions) É versionado.
supabase/.temp
supabase/.branches

# Saída local do fluxo de review de design (impeccable)
.impeccable/

# Carga das fichas de papel e saídas das auditorias.
# CPF, endereço e telefone de clientes reais — este repositório é PÚBLICO.
